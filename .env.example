# Cloud sync (optional).
#
# Leave these unset and RoomKit runs exactly as it always has: local storage
# plus the manual export/import bar. Set them and a "Sign in to sync" control
# appears.
#
# The publishable key is designed to ship in the browser bundle -- it identifies
# the project but grants no access on its own, because every table is behind
# row-level security keyed on your user id. Never put the *service role* key in
# this file; it bypasses RLS entirely and would be readable by anyone who opens
# the deployed site.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
