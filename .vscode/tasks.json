{
  "version": "2.0.0",
  "tasks": [
    {
      // The one F5 depends on. `npm run dev` uses concurrently to bring up the
      // asset server and Vite together in a single integrated terminal.
      "label": "roomkit: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "roomkit",
        "clear": true
      },
      /**
       * Background tasks block the debug launch until the matcher says the
       * server is ready. Without an endsPattern VS Code would either wait
       * forever or open the browser before Vite is listening and show a
       * connection error.
       */
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(VITE|Starting|restarting).*",
          "endsPattern": ".*(Local:.*5173|ready in).*"
        }
      }
    },
    {
      "label": "roomkit: dev (local HMR)",
      "type": "shell",
      "command": "npm run dev:local",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "roomkit" },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(VITE|Starting|restarting).*",
          "endsPattern": ".*(Local:.*5173|ready in).*"
        }
      }
    },
    {
      "label": "roomkit: asset server only",
      "type": "shell",
      "command": "npm run dev:api",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "roomkit" },
      "problemMatcher": {
        "owner": "node",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*RoomKit assets.*"
        }
      }
    },
    {
      "label": "roomkit: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "roomkit: lint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "roomkit: tunnel (ngrok)",
      "type": "shell",
      "command": "npm run tunnel",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "roomkit" },
      "problemMatcher": []
    }
  ]
}
